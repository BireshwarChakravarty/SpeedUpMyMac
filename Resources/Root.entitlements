<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened runtime (required for notarization) blocks Apple Events unless this is declared.
         Root runs its administrator prompt through AppleScript and asks apps to quit before
         uninstalling them; NSAppleEventsUsageDescription in Info.plist explains why. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
